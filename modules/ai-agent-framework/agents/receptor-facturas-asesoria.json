{
  "id": "receptor-facturas-asesoria",
  "name": "receptor-facturas-asesoria",
  "description": "Recibe archivos del bot facturas-asesoria y los guarda en storage/facturas-nonina/recibidas",
  "provider": "deepseek",
  "model": "deepseek-chat",
  "temperature": 0.1,
  "max_tokens": 1000,
  "prompt_file": "prompts/receptor-facturas-asesoria.md",
  "subscribes": [
    "telegram.photo.received",
    "telegram.document.received"
  ],
  "tools": [
    "telegram_get_file",
    "fs_copy",
    "telegram_send_message"
  ],
  "context_enabled": false,
  "enabled": true
}
